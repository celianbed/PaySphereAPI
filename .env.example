# Base de données Neon DB
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Clé secrète Flask (générer avec: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-random-string

# JWT
JWT_SECRET_KEY=change-me-to-another-random-string

# API Key — chaque requête doit envoyer le header X-API-Key (laisser vide pour désactiver)
API_KEY=

# CORS — origines autorisées séparées par des virgules (mettre * pour tout autoriser)
ALLOWED_ORIGINS=http://localhost:3000,https://votre-app.com
