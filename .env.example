# ---------------------------------------------------------------------------
# Variables obligatoires : l'application refuse de démarrer si l'une manque.
# ---------------------------------------------------------------------------

# Base de données PostgreSQL (Neon en production, service `db` en local)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Clés de signature — 32 caractères minimum, différentes l'une de l'autre.
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string-of-64-hex-characters
JWT_SECRET_KEY=change-me-to-another-random-string-of-64-hex-chars

# ---------------------------------------------------------------------------
# Variables optionnelles
# ---------------------------------------------------------------------------

# Clé attendue dans l'en-tête X-API-Key. Laisser vide pour désactiver ce
# filtre. Note : cette clé est embarquée dans l'application mobile et donc
# extractible ; elle limite le trafic automatisé, elle n'authentifie personne.
# La sécurité des données repose sur le JWT.
API_KEY=

# Origines autorisées pour le CORS, séparées par des virgules. Vide = aucune
# origine navigateur autorisée, ce qui est le cas nominal pour une API
# consommée uniquement par l'application mobile.
ALLOWED_ORIGINS=

# Durées de validité des jetons.
JWT_ACCESS_HOURS=1
JWT_REFRESH_DAYS=7
